# Supabase Database Credentials (Session Pooler).
DB_HOST=<host-del-pooler-de-supabase>
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña>
DB_NAME=postgres
DB_SSL=true

# ETL Config.
ETL_TABLA_DESTINO=matriz_caracteristicas
ETL_ESQUEMA_DESTINO=public
ETL_CHUNK_SIZE=50
# Opcionales (estos son sus valores por defecto).
